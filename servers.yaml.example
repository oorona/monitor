# Oracle targets come from databases.json: enable Monitor wallet access there.
servers:
  database:
    test:
      pgserver1:
        pgdb1:
          type: pg
          username: postgres
          password: pgpasswd
      mysqlserver1:
        mysqldb1:
          type: mysql
          username: monitor
          password: mysqlpasswd
  application:
    production:
      appserver1:
        urls: [https://website.com/health]
